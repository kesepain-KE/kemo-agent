# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log

# Backups & temp
*.bak
*.tmp
tmp_unstage_obsidian.txt

# Environment
.env
.env.local

# Node (web)
node_modules/
web/node_modules/

# Test & lint caches
.playwright-cli/
.pytest_cache/
.ruff_cache/
output/

# Web build artifacts
web/frontend/.playwright-cli/
web/frontend/output/

# Obsidian knowledge graph (local dev workspace, not tracked)
开发临时目录/

# User runtime data — only _template skeleton with .gitkeep
users/*/
!users/_template/

# Ignore all files under _template, but keep directories and .gitkeep
users/_template/**/*
!users/_template/**/
!users/_template/**/.gitkeep

# Expand / Sense / Skills — only register.py is tracked
global_expand/*
!global_expand/register.py
global_sense/*
!global_sense/register.py
shared_expand/*
!shared_expand/register.py
shared_skills/*
!shared_skills/register.py

# Message outbound — keep empty folder only
message/out/*
!important: message/out/.gitkeep