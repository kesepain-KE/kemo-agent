# Build the context generated by deploy/pack.py, not the repository root.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 KEMO_DEPLOY_CONTAINER=1
COPY requirements.txt /opt/requirements.txt
RUN python -m venv /opt/venv && /opt/venv/bin/python -m pip install --no-cache-dir -r /opt/requirements.txt
COPY runtime/ /opt/kemo-deploy/
COPY release.zip /opt/kemo-release.zip
COPY entrypoint.py healthcheck.py /opt/
RUN groupadd --gid 1000 kemo && useradd --uid 1000 --gid 1000 --create-home kemo && mkdir /data && chown kemo:kemo /data
USER kemo
WORKDIR /data
VOLUME ["/data"]
EXPOSE 1357
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD ["/opt/venv/bin/python", "/opt/healthcheck.py"]
ENTRYPOINT ["/opt/venv/bin/python", "/opt/entrypoint.py"]

