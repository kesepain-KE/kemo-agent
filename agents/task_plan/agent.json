{
  "schema_version": 1,
  "name": "task_plan",
  "version": "2.0.0",
  "description": "根据显式任务数据创建或编辑结构化任务计划草案，不直接执行工具或写文件。",
  "enabled": true,
  "instruction": "任务计划.txt",
  "model_profile": "reasoning",
  "timeout": 180,
  "execution": "background_serial",
  "write_policy": "user_task",
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["create", "edit"]
      },
      "goal": {
        "type": "string",
        "description": "用户的任务目标描述"
      },
      "available_tools": {
        "type": "array",
        "description": "可用工具清单，每项含 name 和 description",
        "items": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "description": {"type": "string"}
          }
        }
      },
      "max_steps": {
        "type": "integer",
        "description": "最大可创建计划步骤数量"
      },
      "existing_plan": {
        "type": "object",
        "description": "编辑模式时传入的现有计划数据"
      },
      "edit_request": {
        "type": "string",
        "description": "编辑模式时用户的修改要求"
      },
      "relevant_memory": {
        "type": "string",
        "description": "相关记忆摘要，可能过期"
      }
    },
    "required": ["action"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["create", "edit", "skip"]
      },
      "title": {
        "type": "string",
        "description": "计划标题"
      },
      "description": {
        "type": "string",
        "description": "用户原始目标"
      },
      "steps": {
        "type": "array",
        "description": "计划步骤列表",
        "items": {
          "type": "object",
          "properties": {
            "step_id": {"type": "string"},
            "title": {"type": "string"},
            "description": {"type": "string"},
            "depends_on": {
              "type": "array",
              "items": {"type": "string"}
            },
            "tool_name": {"type": "string"},
            "tool_arguments": {"type": "object"},
            "critical": {"type": "boolean"}
          },
          "required": ["step_id", "title", "description", "critical"],
          "additionalProperties": false
        }
      },
      "message": {
        "type": "string",
        "description": "skip 模式时返回的原因说明"
      }
    },
    "required": ["action"],
    "additionalProperties": false
  }
}
