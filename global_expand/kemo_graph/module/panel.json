{
  "schema_version": 1,
  "title": "Kemo Graph 用户配置",
  "containers": [
    {
      "kind": "status",
      "title": "知识图谱后端",
      "width": "full",
      "height": "h2",
      "source": "module/status.json",
      "fields": [
        { "key": "configuration", "label": "配置状态", "type": "badge" },
        { "key": "graph_ip", "label": "知识图谱 IP / 主机", "type": "text" },
        { "key": "graph_port", "label": "知识图谱端口", "type": "text" },
        { "key": "scheme", "label": "协议", "type": "text" },
        { "key": "base_url", "label": "当前 API 地址", "type": "text" },
        { "key": "allow_remote", "label": "允许远程地址", "type": "badge" },
        { "key": "backend_status", "label": "后端状态", "type": "badge" },
        { "key": "last_checked", "label": "最近检测", "type": "text" },
        { "key": "last_error", "label": "最近错误", "type": "text" }
      ]
    },
    {
      "kind": "action",
      "title": "配置知识图谱地址",
      "width": "half",
      "height": "h2",
      "controls": [
        {
          "type": "send",
          "label": "保存知识图谱 IP 与端口",
          "command": "panel_configure_endpoint",
          "inputs": [
            { "key": "scheme", "label": "协议", "type": "enum", "options": [
              { "value": "http", "label": "HTTP" },
              { "value": "https", "label": "HTTPS" }
            ], "required": true },
            { "key": "graph_ip", "label": "知识图谱 IP / 主机", "type": "string", "required": true, "placeholder": "127.0.0.1" },
            { "key": "graph_port", "label": "知识图谱端口", "type": "number", "min": 1, "max": 65535, "default": 8000, "required": true },
            { "key": "allow_remote", "label": "允许远程地址", "type": "boolean" }
          ]
        }
      ]
    },
    {
      "kind": "action",
      "title": "在线检测",
      "width": "half",
      "height": "h1",
      "controls": [
        { "type": "button", "label": "检测知识图谱后端", "command": "panel_check_backend" }
      ]
    }
  ]
}
