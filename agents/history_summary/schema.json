{
  "input_schema": {
    "type": "object",
    "required": ["trigger", "session_id", "target_seq", "records"],
    "properties": {
      "trigger": {
        "type": "string",
        "const": "session_closed"
      },
      "session_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "target_seq": {
        "type": "integer",
        "minimum": 1
      },
      "records": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["seq", "role", "text"],
          "properties": {
            "seq": {"type": "integer", "minimum": 1},
            "role": {"type": "string", "enum": ["user", "assistant"]},
            "text": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": ["title", "summary"],
    "properties": {
      "title": {
        "type": "string",
        "minLength": 8,
        "maxLength": 24
      },
      "summary": {
        "type": "string",
        "minLength": 30,
        "maxLength": 120
      }
    },
    "additionalProperties": false
  }
}
