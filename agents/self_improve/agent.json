{
  "schema_version": 2,
  "name": "self_improve",
  "version": "1.0.0",
  "description": "从显式传入的数据中提取、整理和升级记忆候选。",
  "enabled": true,
  "instruction": "AGENT.md",
  "executor": "executor.py:execute",
  "config": "agent-config.json",
  "model_profile": "reasoning",
  "timeout": 180,
  "execution": "background_serial",
  "write_policy": "user_memory",
  "input_schema": {
    "type": "object",
    "properties": {
      "user_text": {"type": "string"},
      "assistant_text": {"type": "string"},
      "tool_results": {"type": "array"},
      "source": {"type": "object"},
      "existing_candidates": {"type": "array"}
    },
    "required": ["user_text", "assistant_text", "tool_results", "source", "existing_candidates"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "content": {"type": "string"},
            "type": {"type": "string"},
            "confidence": {"type": "number"},
            "importance": {"type": "number"},
            "entities": {"type": "array", "items": {"type": "string"}},
            "keywords": {"type": "array", "items": {"type": "string"}},
            "explicit": {"type": "boolean"},
            "action": {"type": "string"},
            "target": {"type": "string"}
          },
          "required": ["content", "type", "confidence", "importance", "entities", "keywords", "explicit", "action"],
          "additionalProperties": false
        }
      }
    },
    "required": ["candidates"],
    "additionalProperties": false
  }
}
