{
  "schema_version": 2,
  "name": "context_manage",
  "version": "1.0.0",
  "description": "按完整对话轮整理上下文并生成结构化历史摘要。",
  "enabled": true,
  "instruction": "AGENT.md",
  "executor": "executor.py:execute",
  "config": "agent-config.json",
  "model_profile": "cheap",
  "timeout": 120,
  "execution": "sync",
  "write_policy": "derived_cache",
  "input_schema": {
    "type": "object",
    "properties": {
      "previous_summary": {"type": ["object", "null"]},
      "rounds": {"type": "array"},
      "trigger": {"type": "string"}
    },
    "required": ["rounds", "trigger"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "facts": {"type": "array", "items": {"type": "string"}},
      "requirements": {"type": "array", "items": {"type": "string"}},
      "decisions": {"type": "array", "items": {"type": "string"}},
      "unfinished": {"type": "array", "items": {"type": "string"}},
      "tool_results": {"type": "array", "items": {"type": "string"}},
      "entities": {"type": "array", "items": {"type": "string"}},
      "narrative": {"type": "string"}
    },
    "required": ["facts", "requirements", "decisions", "unfinished", "tool_results", "entities", "narrative"],
    "additionalProperties": false
  }
}
