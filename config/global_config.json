{
  "schema_version": 1,
  "provider_runtime": {
    "max_concurrent_requests": 10,
    "request_semaphore_timeout": 300
  },
  "tools": {
    "enabled": true,
    "timeout": 240,
    "max_iterations": 80,
    "consecutive_identical_call_limit": 8,
    "invalid_tool_arguments_retries": 2
  },
  "history": {
    "schema_version": 1,
    "recent_full_rounds": 3,
    "consecutive_tool_fail_limit": 5
  },
  "prompt": {
    "char_limits": {
      "task_plan": 6000,
      "perception": 20000,
      "expand_data": 20000,
      "skill_prompts": 80000,
      "plugin_prompts": 80000
    }
  },
  "memory": {
    "storage_schema_version": 1,
    "extraction_mode": "compression_only",
    "recovery_max_rounds_per_scan": 10,
    "extraction_batch_rounds": 5,
    "extraction_max_candidates_per_batch": 10,
    "temporary_injection_limits": {
      "half_year": 100,
      "one_month": 200,
      "seven_days": 300
    },
    "important_memory_max_chars": 20000,
    "important_memory_output_max_chars": 20000,
    "history_read_enabled": true,
    "tiers": {
      "seven_days": {
        "days": 7,
        "upgrade_threshold": 3,
        "next": "one_month"
      },
      "one_month": {
        "days": 30,
        "upgrade_threshold": 10,
        "next": "half_year"
      },
      "half_year": {
        "days": 180,
        "upgrade_threshold": 60,
        "next": null
      }
    }
  },
  "agent_runtime": {
    "queue_maxsize": 50,
    "default_timeout": 600,
    "timeout_survival_seconds": 120
  },
  "task_plan": {
    "max_steps": 20
  },
  "cron": {
    "enabled": true,
    "poll_interval": 30,
    "avoid_congestion": true,
    "congestion_threshold_ratio": 0.2
  },
  "task_cron_system": {
    "sense_update_rate": 5,
    "expand_update_rate": 5,
    "module_update_timeout": 120
  },
  "runtime_host": {
    "enable_background_scheduler": true
  },
  "history_summary": {
    "poll_interval": 5,
    "max_jobs_per_cycle": 3,
    "max_attempts": 5,
    "retry_delays_seconds": [
      30,
      120,
      600,
      1800
    ]
  },
  "message": {
    "max_workers": 8,
    "max_queued_messages": 20
  },
  "web": {
    "max_concurrent_chats": 3,
    "max_pending_chats": 5,
    "pending_chat_timeout": 30
  },
  "agents": {
    "conserved_rounds": 3,
    "max_rounds": 80,
    "rounds_after_compression": 20,
    "token_limit": 1000000,
    "token_compression_ratio": 0.3,
    "important_memory_review_hours": 3,
    "daily_memory_review_time": "02:00"
  }
}
