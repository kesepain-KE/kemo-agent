# kemo-agent 环境变量示例
# 复制为 .env 后填写本机值；本示例不得包含真实密钥。

# ── Provider 密钥（兜底，user_config.json 中 provider.api_key 优先）──

# Kemo 网关 API Key（provider.type=kemo 时使用）
KEMO_API_KEY=your-kemo-api-key

# Kemo Provider 协议根地址（provider.type=kemo 时使用，留空默认 127.0.0.1:8741）
KEMO_BASE_URL=http://127.0.0.1:8741

# 可选：仅当 provider.model 为空时使用
KEMO_MODEL=

# Chat Completions 兼容模式配置（provider.type=chat 时使用）
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# ── 网络代理（provider 请求外部 API 时使用，如需加速网络）──

# HTTP/HTTPS 代理地址，留空则直连
HTTP_PROXY=
HTTPS_PROXY=

# ── 工具插件 ──

# web_search 插件使用的 Tavily API Key；留空时工具仍可被发现，调用会提示配置
TAVILY_API_KEY=

# ── Web 服务 ──

# Web 监听地址（127.0.0.1 = 仅本机，0.0.0.0 = 暴露局域网）
WEB_HOST=127.0.0.1

# Web 监听端口（默认 1357，冲突自动轮询最多 10 次）
WEB_PORT=1357

# Web 访问令牌（非空时需在 URL 后带 ?token=xxxx 访问；留空则不启用 token 鉴权）
WEB_ACCESS_TOKEN=

# Web 登录用户名（该智能体使用者的用户名，与智能体内部的多用户设计无关）
WEB_USERNAME=

# Web 登录密码（该智能体使用者的用户密码，与智能体内部的多用户设计无关）
WEB_PASSWORD=

# Session 签名密钥（留空时自动生成，浏览器记录登录状态，默认有效期 2 小时）
WEB_SESSION_SECRET=

# Session Cookie 名称（浏览器会话级；多实例使用不同名称避免冲突）
WEB_SESSION_COOKIE_NAME=kemo_agent_session
