{
  "name": "history_search",
  "description": "搜索当前用户已提交对话窗口中的用户与助手文本。不会读取思考记录或工具日志。",
  "input_schema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "description": "要搜索的文字"
      },
      "limit": {
        "type": "integer",
        "description": "最多返回的匹配数",
        "minimum": 1,
        "maximum": 100,
        "default": 10
      }
    },
    "required": ["query"],
    "additionalProperties": false
  },
  "version": "1.0.0",
  "enabled": true,
  "entrypoint": "tool.py:run"
}
