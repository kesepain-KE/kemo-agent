        "iterations": {
          "kind": "json",
          "path": "config/global_config.json",
          "key": [
            "tools",
            "max_iterations"
          ]
        },
        "timeout": {
          "kind": "json",
          "path": "config/global_config.json",
          "key": [
            "tools",
            "timeout"
          ]
        },
        "identical": {
          "kind": "json",
          "path": "config/global_config.json",
          "key": [
            "tools",
            "consecutive_identical_call_limit"
