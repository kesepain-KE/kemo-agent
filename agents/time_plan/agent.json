{
  "schema_version": 2,
  "name": "time_plan",
  "version": "2.0.0",
  "description": "将自然语言定时要求解析为结构化定时任务草案，不直接执行、写文件或调用 CLI。",
  "enabled": true,
  "instruction": "AGENT.md",
  "executor": "executor.py:execute",
  "config": "agent-config.json",
  "model_profile": "default",
  "timeout": 180,
  "execution": "background_serial",
  "write_policy": "user_task",
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["create", "edit", "delete"]
      },
      "user_request": {
        "type": "string",
        "description": "用户的自然语言定时要求"
      },
      "existing_task": {
        "type": "object",
        "description": "编辑或删除时传入的现有任务数据"
      },
      "edit_request": {
        "type": "string",
        "description": "编辑模式时用户的修改要求"
      },
      "current_time_utc": {
        "type": "string",
        "description": "当前 UTC ISO 时间，用于计算 next_run_at"
      },
      "relevant_memory": {
        "type": "string",
        "description": "相关记忆摘要，可能过期"
      }
    },
    "required": ["action"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["create", "edit", "delete", "skip"]
      },
      "title": {
        "type": "string",
        "description": "任务标题"
      },
      "prompt": {
        "type": "string",
        "description": "执行时发给智能体的提示词"
      },
      "schedule": {
        "type": "object",
        "properties": {
          "type": {"type": "string", "enum": ["once", "daily", "recurring"]},
          "time": {"type": "string", "description": "HH:MM，daily 使用"},
          "timezone": {"type": "string", "description": "IANA 时区名称"},
          "start_at": {"type": "string", "description": "UTC ISO，once 使用"},
          "interval_seconds": {"type": "integer", "description": "间隔秒数，recurring 使用，最小 60"}
        },
        "required": ["type"],
        "additionalProperties": false
      },
      "session_id": {
        "type": "string",
        "description": "执行时使用的会话 ID，默认 cron"
      },
      "message": {
        "type": "string",
        "description": "skip 模式时返回的原因说明"
      }
    },
    "required": ["action"],
    "additionalProperties": false
  }
}
