    {
      "kind": "status",
      "title": "采集状态",
      "width": "half",
      "source": "module/status.json",
      "fields": [
        { "key": "health", "label": "健康", "type": "badge" },
        { "key": "timezone", "label": "生效时区", "type": "text" },
        { "key": "local", "label": "观测时间", "type": "text" },
        { "key": "offset", "label": "UTC 偏移", "type": "text" },
        { "key": "last", "label": "最近采集（北京时间）", "type": "text" },
        { "key": "summary", "label": "摘要", "type": "markdown" }
      ]
    },
    {
      "kind": "action",
      "title": "操作",
      "width": "full",
      "controls": [
        { "type": "button", "label": "立即采集", "command": "refresh" }
