# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log
cron/task_cron_system/log/
runtime/
!template/user/runtime/
!template/user/runtime/.gitkeep

# Backups & temp
*.bak
*.tmp
.backups/
.update.lock
.update.maintenance
tmp_unstage_obsidian.txt
tmp/*
!tmp/.gitkeep

# Instance environment configuration and private module credentials
kemo.yaml
kemo.yaml.*
!kemo.yaml.example
.env
.env.*

# Local message routing identity map
config/message_config.json

# Node (web)
node_modules/
web/node_modules/

# Test & lint caches
.playwright-cli/
.pytest_cache/
.ruff_cache/
output/

# Web build artifacts
web/frontend/.playwright-cli/
web/frontend/output/

# Obsidian knowledge graph (local dev workspace, not tracked)
开发临时目录/

# User runtime data — only .gitkeep tracked
users/*/
users/_template/
!users/.gitkeep
template/user/history/*.sqlite3*
template/user/improve/*.sqlite3*
template/user/task_plan/*.sqlite3*

# Expand / Sense / Skills — only register.py is tracked
expand/global/*
!expand/global/register.py
!expand/global/kemo_gateway_status/
!expand/global/kemo_gateway_status/**
!expand/global/kemo_graph/
!expand/global/kemo_graph/**
!expand/global/kemo_app/
!expand/global/kemo_app/**
# Built-in module source is tracked, but private runtime configuration is not.
expand/global/**/.env
expand/global/**/.env.*
!expand/global/**/.env.example
**/kemo-graph-storage/
sense/*
!sense/register.py
expand/share/*
!expand/share/register.py
skills/*
!skills/register.py

# Message outbound — keep empty folder only
message/out/*
!message/out/.gitkeep
*.bak.*
