# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
desktop.ini
.DS_Store

# Logs
*.log

# Backups & temp
*.bak
*.tmp
tmp_unstage_obsidian.txt

# Environment
.env
.env.local

# Node (web)
node_modules/
web/node_modules/

# Test & lint caches
.playwright-cli/
.pytest_cache/
.ruff_cache/
output/

# Web build artifacts
web/frontend/.playwright-cli/
web/frontend/output/

# Obsidian knowledge graph (local dev workspace, not tracked)
开发临时目录/

# User runtime data — only _template skeleton is tracked
users/*/avatar/
users/*/download/
users/*/expand/
users/*/file_upload/
users/*/history/
users/*/improve/
users/*/improve_backup_v1_*/
users/*/knowledge/
users/*/agents/
users/*/message_state/
users/*/task_cron/
users/*/task_plan/
users/*/user_skills/
users/*/user_config.json
users/*/user_soul.md
users/*/memory_temporary_important.md
users/*/*.txt

# Keep _template skeleton tracking (unignore)
!users/_template/
!users/_template/**/.gitkeep

# Expand / Sense / Skills — only register.py is tracked
global_expand/*
!global_expand/register.py
global_sense/*
!global_sense/register.py
shared_expand/*
!shared_expand/register.py
shared_skills/*
!shared_skills/register.py

# Message outbound — keep empty folder only
message/out/*
!important: message/out/.gitkeep