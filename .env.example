# kemo-agent 环境变量示例
# 复制为 .env 后填写本机值；本示例不得包含真实密钥。

# Kemo 网关 API Key
KEMO_API_KEY=your-kemo-api-key

# 默认 CLI 用户；命令行 --user 的优先级更高
KEMO_USER=kesepain

# 可选：仅当 config/global_config.json 中 provider.model 为空时使用
# KEMO_MODEL=deepseek-deepseek-v4-pro

# OpenAI 兼容模式备用配置；provider.type=openai 时使用
OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=your-openai-model
